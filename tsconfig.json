{
    "compilerOptions": {
        "target": "ES2020",
        "module": "preserve",
        "declaration": true,      
        "declarationMap": true,   
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "rootDir": "./src",       
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/tests/*"]
}
